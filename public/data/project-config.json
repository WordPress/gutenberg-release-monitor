{
  "version": "1.0.0",
  "project": {
    "name": "Gutenberg Release Monitor",
    "description": "Track Gutenberg release statistics and changelog data.",
    "projectUrl": "https://github.com/WordPress/gutenberg",
    "projectLabel": "Gutenberg",
    "disclaimer": "This data is an approximation based on parsing Gutenberg release changelogs, and doesn't include cherry-picks to WordPress release branches after the Beta1 cutoff. Contributor sponsor and country data for releases before WP 6.9 / GB 20.5 was collected retroactively and reflects current profiles, not historical affiliations.",
    "learnMoreUrl": "https://developer.wordpress.org/block-editor/contributors/versions-in-wordpress/"
  },
  "tabs": [
    {
      "id": "by-wp-version",
      "title": "By WP Version",
      "dataEndpoint": "aggregated/by-wp-version.json",
      "versionField": "wpVersion",
      "versionPrefix": "WordPress",
      "relatedVersionField": null,
      "supportedViewModes": ["averages", "totals", "distribution", "sponsors", "countries"],
      "tableCardClass": "aggregated-table-card",
      "urlParamKey": "wp",
      "defaultItemSummaryField": "currentWPCycle",
      "isAggregated": true,
      "showReferenceLines": false,
      "labels": {
        "averagesToggle": "Per GB Release",
        "statsHeader": "Averages per Gutenberg release",
        "childItem": "Gutenberg release",
        "versionColumn": "WP Version",
        "childVersionColumn": "GB Versions",
        "parentVersionColumn": null,
        "parentVersionPrefix": null,
        "itemContext": null,
        "specialMarkerTooltip": null,
        "chartSecondaryLabel": "GB releases included"
      }
    },
    {
      "id": "by-gb-release",
      "title": "By GB Release",
      "dataEndpoint": "releases.json",
      "versionField": "gbVersion",
      "versionPrefix": "Gutenberg",
      "relatedVersionField": "wpVersion",
      "supportedViewModes": ["averages", "distribution", "sponsors", "countries"],
      "tableCardClass": null,
      "urlParamKey": "gb",
      "defaultItemSummaryField": null,
      "isAggregated": false,
      "showReferenceLines": true,
      "labels": {
        "averagesToggle": null,
        "statsHeader": null,
        "childItem": null,
        "versionColumn": "GB Version",
        "childVersionColumn": null,
        "parentVersionColumn": "WP Version",
        "parentVersionPrefix": "WP",
        "itemContext": "Included in WordPress {version}",
        "specialMarkerTooltip": "Last Gutenberg version before WordPress beta freeze",
        "chartSecondaryLabel": null
      }
    },
    {
      "id": "by-year",
      "title": "By Year",
      "dataEndpoint": "aggregated/by-year.json",
      "versionField": "year",
      "versionPrefix": "",
      "relatedVersionField": null,
      "supportedViewModes": ["averages", "totals", "distribution", "sponsors", "countries"],
      "tableCardClass": "aggregated-table-card",
      "urlParamKey": "year",
      "defaultItemSummaryField": "currentYear",
      "isAggregated": true,
      "showReferenceLines": false,
      "labels": {
        "averagesToggle": "Per Release",
        "statsHeader": "Averages per release",
        "childItem": "release",
        "versionColumn": "Year",
        "childVersionColumn": "Versions",
        "parentVersionColumn": null,
        "parentVersionPrefix": null,
        "itemContext": null,
        "specialMarkerTooltip": null,
        "chartSecondaryLabel": "Releases included"
      }
    }
  ],
  "dataSources": {
    "summary": "aggregated/summary.json",
    "timeSeries": "aggregated/time-series.json"
  },
  "defaults": {
    "tab": "by-wp-version",
    "viewMode": "averages",
    "chartType": "stacked",
    "metric": "prs",
    "releaseCount": 50
  }
}
