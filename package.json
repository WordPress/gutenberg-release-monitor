{
  "name": "gutenberg-release-monitor",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "parse": "tsx scripts/parse-changelog.ts",
    "aggregate": "tsx scripts/aggregate-data.ts",
    "refresh": "npm run parse && npm run aggregate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.20",
    "@wordpress/components": "^29.0.0",
    "@wordpress/dataviews": "^11.0.0",
    "@wordpress/element": "^6.36.0",
    "@wordpress/icons": "^11.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.59.20",
    "@types/node": "^25.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  }
}
