{
  "name": "gutenberg-release-monitor",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "data-sync:gb-releases": "tsx scripts/build-gb-releases.ts",
    "data-sync:wp-cycles": "tsx scripts/build-wp-cycles.ts",
    "data-sync:contributor-stats": "tsx scripts/compute-contributor-stats.ts",
    "data-sync:all": "npm run data-sync:gb-releases && npm run data-sync:wp-cycles",
    "build-mapping": "tsx scripts/build-username-mapping.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@automattic/charts": "^0.51.0",
    "@tanstack/react-query": "^5.59.20",
    "@wordpress/components": "^29.0.0",
    "@wordpress/dataviews": "^11.0.0",
    "@wordpress/element": "^6.36.0",
    "@wordpress/icons": "^11.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@tanstack/react-query-devtools": "^5.59.20",
    "@types/node": "^25.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.50.0",
    "vite": "^6.0.5",
    "vitest": "^4.0.16"
  }
}
